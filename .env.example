# Django
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY= 
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Cloudflare API (optional; settings only, no API requests are made by this app)
# Store production credentials in your hosting provider, never in source control.
CLOUDFLARE_API_TOKEN=your-scoped-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Enable subdomain/preload HSTS only when every affected hostname is HTTPS-only
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Database (Render injects DATABASE_URL from the managed PostgreSQL resource.)
# Locally, omit DATABASE_URL to use SQLite, or set it to a PostgreSQL connection URL.

# WhatsApp Business Cloud API (Meta)
WHATSAPP_API_TOKEN=your-meta-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_API_VERSION=v19.0

# Redis (for Celery - Render Redis)
REDIS_URL=redis://localhost:6379/0

# Church Info
CHURCH_NAME=Your Church Name
CHURCH_TAGLINE=Ask questions about our sermons
CHURCH_LOGO_URL=

# Rate Limiting
QUESTIONS_PER_IP_PER_HOUR=5
